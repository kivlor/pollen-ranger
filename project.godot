; Pollen Ranger - Godot 4.x Project
; First-person greenhouse reclamation game

config_version=5

[application]

config/name="Pollen Ranger"
config/description="A thumb-sized scout purging the Blight from an overgrown greenhouse"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/textures/icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/size/resizable=true

[input]

; Movement
move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey, { "device": -1, "keycode": 87, "pressed": true })],
}
move_back={
"deadzone": 0.5,
"events": [Object(InputEventKey, { "device": -1, "keycode": 83, "pressed": true })],
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey, { "device": -1, "keycode": 65, "pressed": true })],
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey, { "device": -1, "keycode": 68, "pressed": true })],
}
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey, { "device": -1, "keycode": 32, "pressed": true })],
}
; Combat
shoot={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton, { "device": -1, "button_index": 1, "pressed": true })],
}
aim_down_sights={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton, { "device": -1, "button_index": 2, "pressed": true })],
}
; Glide
deploy_glider={
"deadzone": 0.5,
"events": [Object(InputEventKey, { "device": -1, "keycode": 71, "pressed": true })],
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="environment"
2d_physics/layer_3="projectile"
2d_physics/layer_4="blight"
2d_physics/layer_5="bloom"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
